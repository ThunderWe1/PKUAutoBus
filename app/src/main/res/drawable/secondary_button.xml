<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#F2F0ED" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="#DDD8D1" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#F7E9EB" /><corners android:radius="14dp" /><stroke android:width="1.5dp" android:color="#761828" /></shape></item>
    <item><shape><solid android:color="#FFFFFF" /><corners android:radius="14dp" /><stroke android:width="1.5dp" android:color="#9B2335" /></shape></item>
</selector>
