<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
        <ImageButton android:id="@+id/account" style="@style/UtilityButton" android:layout_gravity="end"
            android:src="@drawable/ic_user_round" android:contentDescription="@string/account" android:tooltipText="@string/account" />
    </FrameLayout>
    <ProgressBar android:id="@+id/loading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:visibility="invisible" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:paddingTop="12dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <LinearLayout android:id="@+id/ticket" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp" android:background="@drawable/ticket_background" android:visibility="gone">
                <Button android:id="@+id/ticket_selector" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/choose_ticket" android:textColor="#9B2335" android:visibility="gone" />
                <TextView android:id="@+id/ticket_route" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="25sp" android:textStyle="bold" android:textColor="#24272E" android:gravity="center" />
                <TextView android:id="@+id/ticket_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#24272E" android:gravity="center" android:layout_marginTop="8dp" />
                <TextView android:id="@+id/ticket_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#62666E" android:gravity="center" android:layout_marginTop="6dp" />
                <FrameLayout android:id="@+id/qr_frame" android:layout_width="256dp" android:layout_height="256dp" android:layout_marginTop="16dp" android:background="#FFFFFF">
                    <ImageView android:id="@+id/qr" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/boarding_qr" />
                    <TextView android:id="@+id/qr_placeholder" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/loading_qr" android:textColor="#62666E" android:textSize="16sp" />
                </FrameLayout>
                <Button android:id="@+id/cancel_reservation" android:layout_width="match_parent" android:layout_height="52dp" android:minHeight="52dp" android:layout_marginTop="20dp" android:background="@drawable/secondary_button" android:text="@string/cancel_reservation" android:textColor="@color/secondary_button_text" android:textSize="16sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/booking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:background="@drawable/ticket_background">
                <TextView android:id="@+id/departure_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_time" android:textSize="64sp" android:fontFamily="sans-serif-light" android:textColor="#24272E" android:gravity="center" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/departure_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#62666E" android:gravity="center" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/from" android:textSize="17sp" android:textColor="#62666E" />
                    <Button android:id="@+id/origin" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="64dp" android:paddingHorizontal="12dp" android:text="@string/choose_campus" android:textSize="17sp" android:textColor="#9B2335" android:tooltipText="@string/switch_campus" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/depart" android:textSize="17sp" android:textColor="#62666E" />
                </LinearLayout>
                <Button android:id="@+id/reserve" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/reserve" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/primary_button" android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="13sp" android:textColor="#9B2335" android:paddingVertical="8dp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center">
        <ImageButton android:id="@+id/refresh" style="@style/UtilityButton" android:src="@drawable/ic_refresh_cw" android:contentDescription="@string/refresh" android:tooltipText="@string/refresh" />
        <ImageButton android:id="@+id/official_portal" style="@style/UtilityButton" android:layout_marginHorizontal="24dp" android:src="@drawable/ic_external_link" android:contentDescription="@string/official_portal" android:tooltipText="@string/official_portal" />
        <ImageButton android:id="@+id/about" style="@style/UtilityButton" android:padding="14dp" android:src="@drawable/ic_info" android:contentDescription="@string/about" android:tooltipText="@string/about" />
    </LinearLayout>
</LinearLayout>
